{
  "variables": {
    "minArea": 1000,
    "minVolume": 5000,
    "minEfficiency": 0,
    "maxDamLen": 200
  },

  "fill-color": [
    "case",
    [
      "all",
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "efficiency"], ["var", "minEfficiency"]],
      ["<=", ["get", "dam_len"], ["var", "maxDamLen"]]
    ],
    [255, 100, 100, 0.6],
    [0, 0, 0, 0]
  ],

  "stroke-color": [
    "case",
    [
      "all",
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "efficiency"], ["var", "minEfficiency"]],
      ["<=", ["get", "dam_len"], ["var", "maxDamLen"]]
    ],
    [180, 0, 0, 1],
    [0, 0, 0, 0]
  ],

  "stroke-width": 1,

  "jsonform": {
    "type": "object",
    "title": "NRP Filter",
    "properties": {
      "minArea": {
        "title": "minimum area [m²]",
        "type": "number",
        "minimum": 0,
        "maximum": 20000,
        "format": "range"
      },

      "minVolume": {
        "title": "minimum volume [m³]",
        "type": "number",
        "minimum": 0,
        "maximum": 100000,
        "format": "range"
      },

      "minEfficiency": {
        "title": "minimum efficiency",
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "step": 1.0,
        "format": "range"
      },

      "maxDamLen": {
        "title": "maximum dam length [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 200,
        "step": 1.0,
        "format": "range"
      }
    }
  }
}