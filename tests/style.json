{
  "variables": {
    "minArea": 1000,
    "minVolume": 5000,
    "minRatio": 0,
    "maxDamLen": 200,
    "maxDist2Water": 10000,
    "maxDh2Water": 100
  },

  "fill-color": [
    "case",
    [
      "all",
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "ratio_area_vol"], ["var", "minRatio"]],
      ["<=", ["get", "dam_len"], ["var", "maxDamLen"]],
      ["<=", ["get", "dist2water"], ["var", "maxDist2Water"]],
      ["<=", ["abs", ["get", "dh2water"]], ["var", "maxDh2Water"]]
    ],
    [255, 100, 100, 0.6],
    [0, 0, 0, 0]
  ],

  "stroke-color": [
    "case",
    [
      "all",
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "ratio_area_vol"], ["var", "minRatio"]],
      ["<=", ["get", "dam_len"], ["var", "maxDamLen"]],
      ["<=", ["get", "dist2water"], ["var", "maxDist2Water"]],
      ["<=", ["abs", ["get", "dh2water"]], ["var", "maxDh2Water"]]
    ],
    [180, 0, 0, 1],
    [0, 0, 0, 0]
  ],

  "stroke-width": 1,

  "jsonform": {
    "type": "object",
    "title": "NRP Filter",
    "properties": {
      "minArea": {
        "title": "Minimum area [m²]",
        "type": "number",
        "minimum": 0,
        "maximum": 20000,
        "format": "range"
      },

      "minVolume": {
        "title": "Minimum volume [m³]",
        "type": "number",
        "minimum": 0,
        "maximum": 100000,
        "format": "range"
      },

      "minRatio": {
        "title": "Minimum ratio area/volume",
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "format": "range"
      },

      "maxDamLen": {
        "title": "Maximum dam length [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 200,
        "step": 1,
        "format": "range"
      },

      "maxDist2Water": {
        "title": "Maximum distance to water [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 3000,
        "step": 1,
        "format": "range"
      },

      "maxDh2Water": {
        "title": "Maximum height difference to water [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 800,
        "step": 1,
        "format": "range"
      }
    }
  }
}