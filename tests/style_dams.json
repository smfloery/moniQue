{
  "variables": {
    "minVolume": 0,
    "minArea": 0,
    "minNrpDq95": 0,
    "minNrpDq50": 0,
    "minDamDq95": 0,
    "maxDist2Water": 3000,
    "maxDh2Water": 1000
  },

  "fill-color": [
    "case",
    [
      "all",
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "nrp_d_q95"], ["var", "minNrpDq95"]],
      [">=", ["get", "nrp_d_q50"], ["var", "minNrpDq50"]],
      [">=", ["get", "dam_d_q95"], ["var", "minDamDq95"]],
      ["<=", ["get", "dist2water"], ["var", "maxDist2Water"]],
      ["<=", ["abs", ["get", "dh2water"]], ["var", "maxDh2Water"]]
    ],
    [255, 100, 100, 0.6],
    [0, 0, 0, 0]
  ],

  "stroke-color": [
    "case",
    ["==", ["geometry-type"], "Polygon"],
    [255, 100, 100, 0.6],
    [0, 0, 0, 0]
  ],

  "stroke-width": 1,

  "jsonform": {
    "type": "object",
    "title": "NRP Filter",
    "properties": {
      "minVolume": {
        "title": "Minimum volume [m³]",
        "type": "number",
        "minimum": 0,
        "maximum": 800000,
        "format": "range"
      },

      "minArea": {
        "title": "Minimum area [m²]",
        "type": "number",
        "minimum": 0,
        "maximum": 100000,
        "format": "range"
      },

      "minNrpDq95": {
        "title": "Minimum NRP diameter q95",
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "step": 0.1,
        "format": "range"
      },

      "minNrpDq50": {
        "title": "Minimum NRP diameter q50",
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "step": 0.1,
        "format": "range"
      },

      "minDamDq95": {
        "title": "Minimum dam diameter q95",
        "type": "number",
        "minimum": 0,
        "maximum": 15,
        "step": 0.1,
        "format": "range"
      },

      "maxDist2Water": {
        "title": "Maximum distance to water [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 3000,
        "step": 1,
        "format": "range"
      },

      "maxDh2Water": {
        "title": "Maximum height difference to water [m]",
        "type": "number",
        "minimum": 0,
        "maximum": 1000,
        "step": 1,
        "format": "range"
      }
    }
  }
}
