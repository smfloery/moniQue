
{
  "variables": {
    "minVolume": 0,
    "minArea": 0,
    "minNrpDq95": 0,
    "minNrpDq50": 0,
    "minDamDq95": 0,
    "maxDist2Water": 3000,
    "maxDh2Water": 1000
  },
  "fill-color": [
    "case",
    [
      "all",
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "nrp_d_q95"], ["var", "minNrpDq95"]],
      [">=", ["get", "nrp_d_q50"], ["var", "minNrpDq50"]],
      [">=", ["get", "dam_d_q95"], ["var", "minDamDq95"]],
      ["<=", ["get", "dist2water"], ["var", "maxDist2Water"]],
      ["<=", ["abs", ["get", "dh2water"]], ["var", "maxDh2Water"]]
    ],
    [255, 100, 100, 0.6],
    [0, 0, 0, 0]
  ],
  "stroke-color": [
    "case",
    [
      "all",
      [">=", ["get", "volume"], ["var", "minVolume"]],
      [">=", ["get", "area"], ["var", "minArea"]],
      [">=", ["get", "nrp_d_q95"], ["var", "minNrpDq95"]],
      [">=", ["get", "nrp_d_q50"], ["var", "minNrpDq50"]],
      [">=", ["get", "dam_d_q95"], ["var", "minDamDq95"]],
      ["<=", ["get", "dist2water"], ["var", "maxDist2Water"]],
      ["<=", ["abs", ["get", "dh2water"]], ["var", "maxDh2Water"]]
    ],
    [40, 40, 40, 1],
    [0, 0, 0, 0]
  ],
  "stroke-width": 2,
  "jsonform": {
    "type": "div",
    "elements": [
      {
        "type": "range",
        "label": "Min. Volumen",
        "options": {
          "variable": "minVolume",
          "min": 0,
          "max": 800000,
          "step": 1000
        }
      },
      {
        "type": "range",
        "label": "Min. Fläche",
        "options": {
          "variable": "minArea",
          "min": 0,
          "max": 100000,
          "step": 100
        }
      },
      {
        "type": "range",
        "label": "Min. NRP d_q95",
        "options": {
          "variable": "minNrpDq95",
          "min": 0,
          "max": 10,
          "step": 0.1
        }
      },
      {
        "type": "range",
        "label": "Min. NRP d_q50",
        "options": {
          "variable": "minNrpDq50",
          "min": 0,
          "max": 10,
          "step": 0.1
        }
      },
      {
        "type": "range",
        "label": "Min. Damm d_q95",
        "options": {
          "variable": "minDamDq95",
          "min": 0,
          "max": 15,
          "step": 0.1
        }
      },
      {
        "type": "range",
        "label": "Max. Distanz zum Wasser",
        "options": {
          "variable": "maxDist2Water",
          "min": 0,
          "max": 3000,
          "step": 1
        }
      },
      {
        "type": "range",
        "label": "Max. Höhenunterschied zum Wasser",
        "options": {
          "variable": "maxDh2Water",
          "min": 0,
          "max": 1000,
          "step": 1
        }
      }
    ]
  }
}
